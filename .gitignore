.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
*.log
.env

# Log fixtures served to PACDS in e2e and replay tests
!tests/e2e/fixtures/*.log
!cases/*/*/*.log

# Local, per-machine Compose tweaks (auto-loaded by docker compose)
compose.override.yaml

# Evaluation run records (scripts/eval.sh)
eval-runs/

# Production deployment: local config, secrets and certificates (deploy/*.example files are the templates)
deploy/pacds.yaml
deploy/.env
deploy/certs/*
!deploy/certs/.gitkeep
deploy/pacds-eval.yaml
