# Copy to .env next to compose.yaml (never commit it). Read by compose.yaml, and by pacds.yaml where it says ${...}.
PACDS_IMAGE=ghcr.io/rophy/pacds:2.1.0
PACDS_BIND=0.0.0.0
PACDS_PORT=8080

PACDS_LLM_BASE_URL=http://vllm.corp.example:8000/v1
PACDS_LLM_MODEL=served-model-name
PACDS_LLM_API_KEY=change-me

PACDS_OIDC_ISSUER=https://sso.corp.example/realms/it
PACDS_GIT_TOKEN=change-me
# Empty, or /etc/pacds/certs/<file>.pem with the file in certs/
PACDS_CA_FILE=

# Outbound proxy for the LLM and git, if any. Log storage and the OIDC issuer are always reached directly.
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,.corp.example

# Evaluation instance (compose.eval.yaml)
# PACDS_EVAL_PORT=8081
# PACDS_EVAL_TRACE_DIR=/srv/pacds-eval/traces
