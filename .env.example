# Copy to .env to use a real LLM in the Kind dev cluster (scripts/dev-setup.sh reads it).
# Without .env the in-cluster fake LLM is used.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4
LLM_API_KEY=sk-or-v1-your-key-here
# Optional: header carrying one ID per evaluation (OpenCode Go requires x-opencode-session)
LLM_SESSION_HEADER=
# Optional: chat_completions (default) or responses (e.g. OpenAI GPT models on OpenCode Go)
LLM_API=
