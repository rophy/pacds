# Copy to .env and fill in values for local Skaffold dev
# .env is gitignored and loaded by skaffold as a ConfigMap

# Git (base URL — repo path comes from service registry)
GIT_URL=https://github.com

# LLM Provider
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your-key-here
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4
# API type: openai-completions (Chat Completions) or openai-responses (Responses API)
LLM_API_TYPE=openai-completions
